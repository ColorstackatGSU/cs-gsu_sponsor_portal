# Copy to .env.local for local dev. .env.local is gitignored and .env.example is
# the shape only.
#
# Vite exposes any VITE_* var to the browser bundle. Do NOT put anything secret
# here: the anon key and API URL are BOTH shipped to every visitor's browser.
# That is the correct posture for Supabase's anon key (it is a public identifier
# gated by RLS) and for the API host (it is the URL of an authenticated API).

# Supabase Auth endpoint the browser signs in against.
#   local:  http://127.0.0.1:54421
#   prod:   https://<your-project-ref>.supabase.co
VITE_SUPABASE_URL=

# Public anon key. Shipped to the browser. Locally this is a fixed demo key that
# every Supabase local install prints from `supabase status` in the backend repo.
VITE_SUPABASE_ANON_KEY=

# Where the Spring service (portal-api) lives.
#   local:  http://localhost:8080
#   prod:   https://api.colorstackatgsu.com
VITE_API_URL=
